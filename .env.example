# Environment variables for local development and Railway deployment
# Portal (Vite)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_c3VyZS1nb29zZS02NzI2LmNsZXJrLmFjY291bnRzLmRldiQ
VITE_CLERK_PROXY_URL=/api/__clerk

# API server
PORT=8080
NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/salama_park
CLERK_SECRET_KEY=sk_test_...
CLERK_PUBLISHABLE_KEY=pk_test_...
BOOTSTRAP_ADMIN_USER_ID=
WEB_DIST_DIR=artifacts/salama-park-portal/dist/public
RUN_MIGRATIONS=true
MIGRATIONS_DIR=lib/db/drizzle

# Google Sheets mirror (optional) — data is still stored in Postgres; this
# additionally pushes each registration / petition / subscription to a Google
# Apps Script web app so the committee keeps its spreadsheet workflow.
# Leave GOOGLE_SHEETS_WEBHOOK_URL empty to disable the mirror.
GOOGLE_SHEETS_WEBHOOK_URL=
GOOGLE_SHEETS_WEBHOOK_SECRET=

# Railway
# PORT will be provided by Railway
# DATABASE_URL provided by Railway Postgres plugin
